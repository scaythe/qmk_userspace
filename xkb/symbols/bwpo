// ┣━━━━━╉─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────╊━━━━━┫
// ┃ ⌫   ┃ A À │ U   │ I   │ E   │ ;   │ C   │ T   │ S   │ R   │ N   ┃     ┃
// ┃ Bksp┃ a à │ u < │ i > │ e ( │ , ) │ c @ │ t + │ s - │ r / │ n * ┃ Del ┃
// ┣━━━━━╉─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────╊━━━━━┫
// ┃ ⇧   ┃ !   │ Y   │ X   │ : È │ K   │ ?   │ Q   │ G   │ H   │ F Ç ┃ ⇧   ┃
// ┃ Shft┃ " \ │ y { │ x } │ . è │ k ~ │ '   │ q   │ g ` │ h # │ f ç ┃ Shft┃
// ┣━━━━━╋━━━━━╈━━━━━╈━━━━━╈━━━━━╅─────╆━━━━━╈━━━━━╈━━━━━╈━━━━━╈━━━━━╋━━━━━┫
