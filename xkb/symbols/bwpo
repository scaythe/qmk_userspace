// ┣━━━━━━━╋━━━━━┷━┳━━━┷━━━┱─┴─────┴─────┴─────┴─────┴─────┴───┲━┷━━━━━╈━━━━━┻━┳━━━━━━━┳━━━┛
// ┃	   ┃	   ┃	   ┃                                   ┃       ┃       ┃       ┃
// ┃Ctrl   ┃Meta   ┃Alt    ┃ ␣ Spc                             ┃AltGr ⇮┃Meta   ┃Ctrl   ┃
// ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹───────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┛

xkb_symbols "full" {
    include "pc(pc105)"
    include "level3(ralt_switch)"
    include "bwpo(common)"

    name[Group1]="bwpo (full)";

    key <AE11> { [ F13 ] };

    key <AD11> { [ Multi_key ] }; // compose

    key <CAPS> { [ BackSpace ] };
    key <AC11> { [ Delete ] };

    key <LSGT> { [ slash ] }; // extra
};

partial alphanumeric_keys
xkb_symbols "common" {
    key <AE01> { [ 1 ] };
    key <AE02> { [ 2 ] };
    key <AE03> { [ 3 ] };
    key <AE04> { [ 4 ] };
    key <AE05> { [ 5 ] };
    key <AE06> { [ 6 ] };
    key <AE07> { [ 7 ] };
    key <AE08> { [ 8 ] };
    key <AE09> { [ 9 ] };
    key <AE10> { [ 0 ] };

    key <AD01> { [ b, B, bar ] };
    key <AD02> { [ w, W, eacute, Eacute ] };
    key <AD03> { [ p, P, ampersand ] };
    key <AD04> { [ o, O, bracketleft ] };
    key <AD05> { [ z, Z, bracketright ] };
    key <AD06> { [ m, M ] };
    key <AD07> { [ v, V, equal ] };
    key <AD08> { [ d, D, numbersign ] };
    key <AD09> { [ l, L, dollar ] };
    key <AD10> { [ j, J, asciicircum ] };

    key <AC01> { [ a, A, agrave, Agrave ] };
    key <AC02> { [ u, U, less ] };
    key <AC03> { [ i, I, greater ] };
    key <AC04> { [ e, E, parenleft ] };
    key <AC05> { [ comma, semicolon, parenright ] };
    key <AC06> { [ c, C, at ] };
    key <AC07> { [ t, T, plus ] };
    key <AC08> { [ s, S, minus ] };
    key <AC09> { [ r, R, slash ] };
    key <AC10> { [ n, N, asterisk ] };

    key <AB01> { [ quotedbl, exclam, backslash ] };
    key <AB02> { [ y, Y, braceleft ] };
    key <AB03> { [ x, X, braceright ] };
    key <AB04> { [ period, colon, egrave, Egrave ] };
    key <AB05> { [ k, K, asciitilde ] };
    key <AB06> { [ apostrophe, question ] };
    key <AB07> { [ q, Q, underscore ] };
    key <AB08> { [ g, G, grave ] };
    key <AB09> { [ h, H, percent ] };
    key <AB10> { [ f, F, ccedilla, Ccedilla ] };
};
