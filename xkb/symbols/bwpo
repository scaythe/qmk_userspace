// unused
// TLDE


default xkb_symbols "ortho" {
    include "us"
    include "level3(ralt_switch)"
    include "compose(menu)"
    include "bwpo(common)"

    name[Group1]="bwpo (ortho)";

    // Accented letters on US keys that the grid lacks
    key <AE11> { [ acircumflex, Acircumflex ] };
    key <AE12> { [ ucircumflex, Ucircumflex ] };
    key <AD11> { [ icircumflex, Icircumflex ] };
    key <AD12> { [ ecircumflex, Ecircumflex ] };
    key <BKSL> { [ ocircumflex, Ocircumflex ] };
    // Same key as ù on AZERTY
    key <AC11> { [ ugrave, Ugrave ] };
};

// bwpo full
//
// ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━┓
// │     │     │     │     │     │     │     │     │     │     │     │     │     ┃ ⌫ Bksp  ┃
// │ F13 │ 1   │ 2   │ 3   │ 4   │ 5   │ 6   │ 7   │ 8   │ 9   │ 0   │     │     ┃         ┃
// ┢━━━━━┷━┱───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┴─┬───┺━┳━━━━━━━┫
// ┃	   ┃ B   │ W É │ P   │ O   │ Z   │ M   │ V   │ D   │ L   │ J   │     │     ┃Ret    ┃
// ┃Tab ↹  ┃ b | │ w é │ p & │ o [ │ z ] │ m € │ v = │ d % │ l ^ │ j $ │Comp │     ┃   ⏎   ┃
// ┣━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓	   ┃
// ┃⌫ Bksp  ┃ A À │ U   │ I   │ E   │ ;   │ C   │ T   │ S   │ R   │ N   │     │     ┃	   ┃
// ┃        ┃ a à │ u < │ i > │ e ( │ , ) │ c @ │ t + │ s - │ r / │ n * │ Del │     ┃	   ┃
// ┣━━━━━━━┳┹────┬┴────┬┴────┬┴────┬┴────┬┴────┬┴────┬┴────┬┴────┬┴────┬┴────┲┷━━━━━┻━━━━━━┫
// ┃	   ┃     │ !   │ Y   │ X   │ : È │ K   │ ?   │ Q   │ G   │ H   │ F Ç ┃             ┃
// ┃Shift ⇧┃     │ " \ │ y { │ x } │ . è │ k ~ │ '   │ q   │ g ` │ h # │ f ç ┃Shift ⇧	   ┃
// ┣━━━━━━━╋━━━━━┷━┳━━━┷━━━┱─┴─────┴─────┴─────┴─────┴─────┴───┲━┷━━━━━╈━━━━━┻━┳━━━━━━━┳━━━┛
// ┃	   ┃	   ┃	   ┃                                   ┃       ┃       ┃       ┃
// ┃Ctrl   ┃Meta   ┃Alt    ┃ ␣ Spc                           _ ┃AltGr ⇮┃Meta   ┃Ctrl   ┃
// ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹───────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┛

xkb_symbols "full" {
    include "pc(pc105)"
    include "level3(ralt_switch)"
    include "bwpo(common)"

    name[Group1]="bwpo (full)";

    key <AE11> { [ F13 ] };

    key <AD11> { [ Multi_key ] }; // compose

    key <CAPS> { [ BackSpace ] };
    key <AC11> { [ Delete ] };
};

partial alphanumeric_keys
xkb_symbols "common" {
    key <AE01> { [ 1 ] };
    key <AE02> { [ 2 ] };
    key <AE03> { [ 3 ] };
    key <AE04> { [ 4 ] };
    key <AE05> { [ 5 ] };
    key <AE06> { [ 6 ] };
    key <AE07> { [ 7 ] };
    key <AE08> { [ 8 ] };
    key <AE09> { [ 9 ] };
    key <AE10> { [ 0 ] };

    key <AD01> { [ b, B, bar ] };
    key <AD02> { [ w, W, eacute, Eacute ] };
    key <AD03> { [ p, P, ampersand ] };
    key <AD04> { [ o, O, bracketleft ] };
    key <AD05> { [ z, Z, bracketright ] };
    key <AD06> { [ m, M, EuroSign ] };
    key <AD07> { [ v, V, equal ] };
    key <AD08> { [ d, D, percent ] };
    key <AD09> { [ l, L, asciicircum ] };
    key <AD10> { [ j, J, dollar ] };

    key <AC01> { [ a, A, agrave, Agrave ] };
    key <AC02> { [ u, U, less ] };
    key <AC03> { [ i, I, greater ] };
    key <AC04> { [ e, E, parenleft ] };
    key <AC05> { [ comma, semicolon, parenright ] };
    key <AC06> { [ c, C, at ] };
    key <AC07> { [ t, T, plus ] };
    key <AC08> { [ s, S, minus ] };
    key <AC09> { [ r, R, slash ] };
    key <AC10> { [ n, N, asterisk ] };

    key <AB01> { [ quotedbl, exclam, backslash ] };
    key <AB02> { [ y, Y, braceleft ] };
    key <AB03> { [ x, X, braceright ] };
    key <AB04> { [ period, colon, egrave, Egrave ] };
    key <AB05> { [ k, K, asciitilde ] };
    key <AB06> { [ apostrophe, question ] };
    key <AB07> { [ q, Q ] };
    key <AB08> { [ g, G, grave ] };
    key <AB09> { [ h, H, numbersign ] };
    key <AB10> { [ f, F, ccedilla, Ccedilla ] };

    key <SPCE> { [ space, space, underscore ] };

    // Slash without AltGr, so that Ctrl with this key gives the Ctrl+/ shortcuts
    key <LSGT> { [ slash ] };
};
